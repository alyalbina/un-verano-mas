extends "res://tests/episode_playthrough.gd"
func established()->RefCounted:
	var s=unlocked();s.jug=true;s.jug_filled=true;s.seen_arch=true;s.seen_reflection=true;s.street_open=true
	s.cup_filled=true;s.heard_motif=true;s.echo_fixed=true;s.connection_found=true;return s
func run()->void:
	capture="--capture" in OS.get_cmdline_user_args()
	game=load("res://scenes/reboot.tscn").instantiate();root.add_child(game);await frames(15)
	game.chapter=established();game.chapter.visit("street");game._mount("street");await frames(5)
	await click(Vector2(928,406));await settle();check(game.chapter.location=="workshop","Actual open arch enters workshop")
	await shot("15_workshop")
	await click(Vector2(563,369));await settle();check(not game.chapter.frame_fixed,"Empty drive gives reversible failure")
	await click(Vector2(439,451));await settle();check(game.chapter.belt_taken and game.chapter.spool_moved,"Cat retrieves belt through live event")
	await select_inventory("belt");await click(Vector2(596,316));await settle();check(game.chapter.belt_installed and not "belt" in game.chapter.inventory(),"Belt physically transferred from bag")
	await click(Vector2(563,369));await settle();check(not game.chapter.frame_fixed,"Loose belt cannot carry rotation")
	await click(Vector2(658,320));await settle();check(game.chapter.belt_tension==1,"Live tension control aligns drive")
	await click(Vector2(905,205));await settle();check(game.chapter.back_seen,"Reverse connection observable in mirror")
	await shot("16_back")
	await click(Vector2(430,160));await frames()
	await click(Vector2(876,350));await settle();check(game.chapter.workshop_linked,"Live tube links fountain output")
	await click(Vector2(563,369));await settle();check(not game.chapter.frame_fixed and "workshop_loop" in game.chapter.notes,"Wrong sector visibly returns light")
	for i:int in 4:await click(Vector2(746,254));await settle()
	await click(Vector2(563,369));await settle();check(game.chapter.frame_fixed,"Trial repairs actual mechanism")
	await shot("17_fixed")
	await click(Vector2(810,395));await settle();check(game.chapter.frame_taken,"Recovered frame can be carried")
	await key(KEY_T);await click(Vector2(818,252));await settle();check(game.chapter.location=="passage","Map returns player to actual loggia")
	await select_inventory("frame");await click(Vector2(1000,420));await settle();check(game.chapter.frame_placed and game.world.journey.route_visible,"Carried frame opens in-world map")
	await click(Vector2(753,454));await drag(Vector2(831,381),Vector2(997,251))
	await click(Vector2(991,451));check(not game.chapter.route_open,"Closed latch still produces visible loop failure")
	await click(Vector2(695,378));await click(Vector2(991,451));check(game.chapter.route_open,"Actual anchor, drag and latch establish material route")
	await shot("18_route")
	# Locked route cannot be accidentally destroyed on a later revisit.
	await click(Vector2(718,256));await drag(Vector2(831,381),Vector2(781,491));await click(Vector2(695,378))
	check(game.chapter.route_anchor=="courtyard" and not game.chapter.route_loop,"Anchored route survives later experiments")
	await key(KEY_T);await click(Vector2(531,252));await settle();check(game.chapter.location=="kitchen","Kitchen remains reachable")
	await click(Vector2(1130,400));await settle();check(game.chapter.departed,"Conversation authorizes real departure")
	await key(KEY_T);await click(Vector2(233,252));await settle()
	await click(Vector2(1135,668));await settle();check(game.chapter.location=="harbor","Actual continuation walks to harbor")
	await shot("19_harbor")
	await click(Vector2(630,410));await settle();check("harbor_net" in game.chapter.notes,"Personal catamaran detail recorded")
	await click(Vector2(1160,380));await settle();check("harbor_icecream" in game.chapter.notes,"Shared ice cream memory recorded")
	game.test_mode=false;game.save_path="user://qa_journey_play.json";check(game._save_game(),"New ending writes to disk")
	var truth:Dictionary=game.chapter.serialize();game.chapter=State.new();game._load_game()
	check(game.chapter.location=="harbor" and game.chapter.departed and game.chapter.route_open,"Actual disk read retains completed chapter")
	game._mount("harbor");await frames(5);check(is_instance_valid(game.world.journey),"Ending scene rebuilt from restored truth")
	await key(KEY_T);await shot("20_map");game.close_modal()
	await click(Vector2(1135,668));await settle();check(game.chapter.location=="courtyard","Safe physical return remains available")
	DirAccess.remove_absolute(game.save_path);game.test_mode=true
	game._stop_audio();await create_timer(.3).timeout
	print("JOURNEY PLAYTHROUGH ",checks-failures,"/",checks);quit(1 if failures else 0)
