extends "res://tests/episode_playthrough.gd"
func click_hud(p:Vector2)->void:
	var e:=InputEventMouseButton.new();e.button_index=MOUSE_BUTTON_LEFT;e.position=p;e.global_position=p;e.pressed=true;Input.parse_input_event(e);await frames(3)
	e=InputEventMouseButton.new();e.button_index=MOUSE_BUTTON_LEFT;e.position=p;e.global_position=p;e.pressed=false;Input.parse_input_event(e);await frames(3)
func arrow(code:int,pressed_value:bool)->void:
	var e:=InputEventKey.new();e.keycode=code;e.pressed=pressed_value;Input.parse_input_event(e);await frames(3)
func run()->void:
	capture="--capture" in OS.get_cmdline_user_args()
	game=load("res://scenes/reboot.tscn").instantiate();root.add_child(game);await frames(20)
	check(game.world.world_bounds().size.x==3840,"Courtyard is three screens, without zoom")
	check(game.world.lucia.base_height==282,"Actor size unchanged")
	var hud:Vector2=game.ui.next_button.global_position
	await click_hud(Vector2(31,580));await settle(12)
	check(game.world.lucia.position.x<-1100,"Real HUD arrow walks deeply LEFT")
	check(absf(game.world.panorama.camera.position.x+640)<1,"Camera reaches left limit")
	check(game.ui.next_button.global_position==hud,"HUD does not scroll with world")
	check(not game.chapter.photo,"Exploration does not accidentally trigger central puzzle")
	await shot("wide_01_courtyard_left")
	await click(Vector2(-985,394));await settle()
	check("courtyard_breakfast" in game.chapter.notes,"Scrolled click reaches breakfast at its real world position")
	await arrow(KEY_RIGHT,true)
	var deadline:int=Time.get_ticks_msec()+18000
	while game.world.lucia.position.x<2280 and Time.get_ticks_msec()<deadline:await process_frame
	await arrow(KEY_RIGHT,false);await settle()
	check(game.world.lucia.position.x>2200,"Held key crosses more than two screens RIGHT")
	check(absf(game.world.panorama.camera.position.x-1920)<1,"Camera reaches right limit")
	check(game.world.lucia.position.x<2461,"Actor remains inside navigation bounds")
	await shot("wide_02_courtyard_right")
	await click(Vector2(1880,336));await settle()
	check("courtyard_sundial" in game.chapter.notes,"Right-side object is interactable after scrolling")
	game.ui_action("notebook");var position_before:Vector2=game.world.lucia.position;var camera_before:Vector2=game.world.panorama.camera.position
	await click_hud(Vector2(1245,580));await arrow(KEY_LEFT,true);await frames(20)
	check(game.world.lucia.position==position_before and game.world.panorama.camera.position==camera_before,"Modal freezes walking and camera")
	game.close_modal();await arrow(KEY_LEFT,false)
	game.test_mode=false;game.save_path="user://qa_panorama.json";check(game._save_game(),"Wide pose saves to actual disk")
	var saved_x:int=game.chapter.positions.courtyard[0]
	game.chapter=State.new();game._load_game();game._mount("courtyard");await frames(20)
	check(absf(game.world.lucia.position.x-saved_x)<17,"Reload restores exploration position instead of teleporting to center")
	check(game.world.panorama.camera.position.x>1000,"Reload camera frames distant character immediately")
	DirAccess.remove_absolute(game.save_path);game.test_mode=true
	game.change_scene("kitchen");await settle()
	check(absf(game.get_viewport().get_canvas_transform().origin.x)<1,"Indoor camera clears previous horizontal offset")
	check(not game.ui.left_walk.visible and not game.ui.right_walk.visible,"Indoor room remains framed, navigation arrows hidden")
	await click(Vector2(934,426));await settle();check(game.chapter.mirror,"Original indoor item still uses correct click coordinates")
	game.chapter=unlocked();game.chapter.visit("street");game._mount("street");await frames(20)
	await click_hud(Vector2(31,580));await settle(12)
	check(game.world.lucia.position.x<-1100,"Street extends deeply to left")
	await click(Vector2(-790,342));await settle()
	check("street_helados" in game.chapter.notes,"Ice cream shop interaction uses scrolled coordinates")
	await shot("wide_03_heladeria")
	await click_hud(Vector2(1247,580));await settle(18)
	check(game.world.lucia.position.x>2400,"Street extends deeply to right")
	check(game.world.cat.position.x>1700,"Companion follows into added spaces")
	await click(Vector2(1990,350));await settle();check("street_lookout" in game.chapter.notes,"Coastal view interaction")
	await shot("wide_04_street_coast")
	game.show_pause();check(paused,"Pause works while camera is away from center");game.close_modal()
	game.change_scene("plaza");await settle()
	await click_hud(Vector2(31,580));await settle(12)
	check(game.world.lucia.position.x<-1100,"Plaza extends to cafe terrace")
	await click(Vector2(-915,410));await settle();check("plaza_cafe" in game.chapter.notes,"Cafe interaction")
	await shot("wide_05_plaza_cafe")
	await click_hud(Vector2(1247,580));await settle(18)
	check(game.world.lucia.position.x>2400,"Plaza extends to coastal promenade")
	await click(Vector2(1785,379));await settle();check("plaza_coast" in game.chapter.notes,"Tile map on far side is inspectable")
	await shot("wide_06_plaza_coast")
	game._stop_audio();await create_timer(.3).timeout
	print("PANORAMA PLAYTHROUGH ",checks-failures,"/",checks);quit(1 if failures else 0)
